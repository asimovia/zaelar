<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for a store build, rendered by scripts/ios-archive.sh into App.entitlements (not tracked) with the
  hosts in env ZAELAR_APP_LINKS_HOST (comma-separated: the engine host the app opens, plus the host where people sign
  in on the web if it is another one). Each host gets one applinks: and one webcredentials: line, in place of the
  marker line below. It is a template, not part of every build, because:
    · the host is deployment data, not mechanism;
    · Associated Domains needs a paid team — a personal team's device build (scripts/ios-device.sh) signs without it.
  applinks: universal links into /m (V2-870 §4); every host must serve /.well-known/apple-app-site-association.
  webcredentials: iOS offers, and fills with Face ID, the password saved for that host when the app's sign-in page
  asks for it — the host's apple-app-site-association must list this app under "webcredentials".
  No aps-environment yet: native push comes with its own step.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<!--ASSOCIATED_DOMAINS-->
	</array>
</dict>
</plist>
