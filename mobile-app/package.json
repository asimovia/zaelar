{
  "name": "zaelar-mobile-app",
  "private": true,
  "version": "1.0.0",
  "description": "Native companion: the engine's /m shell in a Capacitor WebView (V2-870).",
  "scripts": {
    "sync": "sh scripts/version.sh && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios",
    "ios:device": "sh scripts/ios-device.sh",
    "icons": "../.venv/bin/python scripts/icons.py",
    "ios:archive": "sh scripts/ios-archive.sh",
    "ios:upload": "sh scripts/ios-upload.sh"
  },
  "dependencies": {
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.10",
    "@capacitor/geolocation": "7.1.8",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/ios": "7.6.10",
    "@capacitor/keyboard": "7.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "typescript": "5.9.3"
  }
}
