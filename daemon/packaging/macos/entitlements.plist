<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Zaelar.app — the MINIMUM the bundle needs to run, nothing for convenience.
    allow-jit                         the bundled Playwright driver is Node, whose V8 compiles JavaScript at run time
    allow-unsigned-executable-memory  the bundled CPython's ctypes/libffi closures (PyObjC, the menu-bar icon)
  Not here, on purpose: disable-library-validation (every dylib in the bundle is signed by the same team),
  network or file entitlements (those are App Sandbox, which this app does not use), and anything for debugging.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
