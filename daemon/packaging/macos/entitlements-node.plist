<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for ONE binary of Zaelar.app: the bundled Node that drives Playwright
  (`Contents/Frameworks/playwright/driver/node`). Every other Mach-O in the bundle is signed with NONE.
    allow-jit   V8 compiles JavaScript at run time; without it Node dies on its first JIT page (measured 2026-11-10).
  Not here, on purpose, and measured unnecessary: allow-unsigned-executable-memory (allow-jit alone runs Node; the
  Python runtime and its tray need nothing), disable-library-validation (every dylib in the bundle is re-signed by
  the same team), and anything for debugging. See `sign_and_notarize.sh` §«ENTITLEMENTS ARE PER BINARY».
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
