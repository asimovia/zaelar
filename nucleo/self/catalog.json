{
  "_doc": "The agent's catalogue of ITSELF (V2-932): one entry per topic a person asks about — what it is, how it is done by voice and by button, what it does not do. `covers` names every act, tool, native surface, settings section, connector and widget the entry speaks for (`act:` · `tool:` · `surface:` · `settings:` · `connector:` · `widget:`); `needs` names the live facts (`nucleo/self/snapshot.py`) the answer reads. The words live in `i18n/genesis/<lang>/self.json` under the same id. `tests/infrastructure/unit/test_everything_it_can_do_is_in_its_self_catalog.py` fails when something the engine can do is in no entry.",
  "entries": [
    {"id": "overview", "needs": ["name", "widgets", "connectors", "host"],
     "covers": ["tool:about_self", "tool:escalate_to_slowbrain", "tool:web_search", "tool:search_listings", "tool:stop_worker",
                "tool:resume_task", "tool:reopen_task", "tool:cancel_scheduled", "surface:status"]},
    {"id": "identity", "needs": ["name"], "covers": ["tool:set_style_directive"]},
    {"id": "wake_word", "needs": ["name", "wake_mode"], "covers": []},
    {"id": "face", "needs": ["face", "face_on", "face_recent"],
     "covers": ["act:presence_on", "act:presence_off", "act:presence_settings", "settings:presence"]},
    {"id": "camera", "needs": ["camera", "face_on", "face_recent"], "covers": ["act:camera_on", "act:camera_off"]},
    {"id": "voice", "needs": ["voice", "language"],
     "covers": ["tool:agent_controls", "act:voice_male", "act:voice_female", "act:voice_list", "act:voice_settings", "act:mute",
                "act:unmute", "act:volume_up", "act:volume_down", "act:volume_set", "act:mic_off", "act:off", "settings:voice",
                "surface:orb"]},
    {"id": "language", "needs": ["language"], "covers": ["act:language"]},
    {"id": "chat", "needs": [], "covers": ["surface:chat"]},
    {"id": "widgets", "needs": ["widgets"],
     "covers": ["tool:show_widget", "tool:close_widget", "tool:widget_data", "tool:read_widget", "tool:delete_widget",
                "tool:restore_widget", "tool:confirm_widget_delete", "tool:manage_widget_alias", "tool:fullscreen_widget",
                "tool:arrange_canvas", "tool:show_panel", "surface:apps", "settings:widgets", "settings:apariencia",
                "widget:activity", "widget:agenda", "widget:archivos", "widget:clock", "widget:contactos", "widget:documento",
                "widget:map", "widget:markets", "widget:mensajeria", "widget:navegador", "widget:results", "widget:search",
                "widget:timer"]},
    {"id": "media", "needs": ["connectors"],
     "covers": ["tool:play_music", "tool:play_video", "tool:show_images", "settings:music", "widget:musica", "widget:youtube",
                "widget:imagenes", "widget:fotos", "connector:spotify", "connector:youtube-audio", "connector:youtube",
                "connector:google-photos", "connector:torrent"]},
    {"id": "settings", "needs": ["host"],
     "covers": ["surface:config", "surface:debug", "surface:wizard", "settings:settings", "settings:fast",
                "settings:code", "settings:memory", "settings:search", "settings:apis", "settings:notices"]},
    {"id": "privacy", "needs": [],
     "covers": ["surface:memory-map", "surface:vault", "settings:rules", "settings:permissions", "tool:recall",
                "tool:reveal_secret"]},
    {"id": "connectors", "needs": ["connectors"],
     "covers": ["surface:conectores", "settings:conectores", "connector:email", "connector:gdrive", "connector:google",
                "connector:google-account", "connector:google-meet", "connector:onedrive", "connector:telegram",
                "connector:whatsapp", "tool:reply_message", "tool:authenticate_web", "tool:login_done"]},
    {"id": "clusters", "needs": ["clusters"],
     "covers": ["connector:meshkore", "connector:architect", "tool:connect_cluster", "tool:cluster_send",
                "tool:set_cluster_objective", "tool:a2a_send", "tool:a2a_connect", "tool:a2a_grant", "tool:a2a_read"]},
    {"id": "where_it_lives", "needs": ["host", "build"], "covers": []},
    {"id": "devices", "needs": ["screens", "daemon", "host"], "covers": []},
    {"id": "feedback", "needs": [], "covers": ["surface:feedback"]},
    {"id": "energy", "needs": ["host"], "covers": []}
  ]
}
