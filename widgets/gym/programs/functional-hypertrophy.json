    "en": "Adaptation",
    "es": "Adaptación"
   },
   "days": 10,
   "session_min": 40,
   "intensity": {
    "en": "controlled · never to failure",
    "es": "controlada · sin llegar al fallo"
   },
   "rpe_target": 7,
   "note": {
    "en": "Joints and tendons first. Do NOT go to failure. Effort 7/10 RPE.",
    "es": "Articulaciones y tendones primero. NO ir al fallo. Sensación 7/10 RPE."
   }
  },
